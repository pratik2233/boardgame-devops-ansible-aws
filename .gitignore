# Maven/Java build output
target/
*.jar
*.war
*.ear
*.class

# Maven local wrapper/cache
.mvn/
.m2/

# Logs
*.log
logs/

# OS/editor files
.DS_Store
.vscode/
.idea/
*.swp

# Docker/temporary files
.tmp/
